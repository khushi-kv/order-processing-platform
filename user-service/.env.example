# Copy to .env (git-ignored) and fill in real values.
DB_USERNAME=admin
DB_PASSWORD=admin
# HS256 signing key, at least 32 characters; Kong's JWT credential uses the same value
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# First admin, created at startup if no account has this email yet
ADMIN_EMAIL=admin@orderplatform.local
ADMIN_PASSWORD=change-me-Admin1
